{
  "name": "@botdock/openclaw-provider",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw provider plugin that exposes the curated BotDock model catalog routed via BotDock Router.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "package.json"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "providers": ["botdock"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.5.7",
      "pluginSdkVersion": "2026.5.7"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "package": "./package.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
