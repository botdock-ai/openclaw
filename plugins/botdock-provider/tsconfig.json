{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "types.d.ts",
    "botdock-models.ts",
    "botdock-capabilities-cache.ts",
    "provider-catalog.ts",
    "onboard.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
